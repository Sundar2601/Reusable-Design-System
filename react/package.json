{
  "name": "@bounteous/ui",
  "private": false,
  "version": "0.0.0",
  "description": "Bounteous design system for React (shadcn/ui on Radix, restyled to the Figma tokens).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./theme.css": "./src/theme/theme.css",
    "./utilities.css": "./src/theme/utilities.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "src/theme",
    "tokens/figma-tokens.json"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json --resolve-full-paths false",
    "prepack": "npm run build:lib",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "angular:install": "npm --prefix ../angular install",
    "storybook:angular": "npm --prefix ../angular run storybook:composed",
    "storybook:all": "npm run storybook:angular & npm run storybook",
    "build-storybook:all": "storybook build && npm --prefix ../angular run build-storybook -- --output-dir ../react/storybook-static/angular",
    "tokens:check": "node scripts/check-tokens.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.1.0",
    "@formisch/react": "^1.2.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "playwright": "latest",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "storybook": "^10.6.6",
    "tsc-alias": "^1.9.10",
    "typescript": "~7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
